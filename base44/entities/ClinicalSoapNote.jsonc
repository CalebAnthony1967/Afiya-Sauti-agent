{
  "name": "ClinicalSoapNote",
  "type": "object",
  "properties": {
    "note_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "FK to TriageSession"
    },
    "profile_id": {
      "type": "string"
    },
    "clinician_id": {
      "type": "string"
    },
    "subjective": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "assessment": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "icd11_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "feature_attribution_weights": {
      "type": "object",
      "additionalProperties": true,
      "description": "Weight per feature contributing to assessment"
    },
    "ai_draft": {
      "type": "boolean",
      "default": true
    },
    "signed": {
      "type": "boolean",
      "default": false
    },
    "signed_by": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_hash": {
      "type": "string",
      "description": "Cryptographic signature hash"
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "session_id",
    "clinician_id"
  ]
}