{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "appointment_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "clinician_id": {
      "type": "string"
    },
    "facility_id": {
      "type": "string"
    },
    "appointment_date": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "confirmed",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "scheduled"
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "profile_id",
    "appointment_date"
  ]
}